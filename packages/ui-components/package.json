{
  "name": "ui-components",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:ts": "tsup",
    "build:css": "sass src/styles/main.scss dist/styles.css --no-source-map",
    "build": "yarn build:ts && yarn build:css",
    "lint:ts": "eslint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "^10.5.4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "contracts": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-storybook": "^10.5.4",
    "storybook": "^10.5.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "^8.1.5"
  },
  "peerDependencies": {
    "contracts": "workspace:*"
  }
}

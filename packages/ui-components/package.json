{
  "name": "@lwn-simulator/ui-components",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:ts": "tsup",
    "build:css": "sass src/styles/main.scss dist/styles.css --no-source-map",
    "build": "yarn build:ts && yarn build:css",
    "lint:ts": "eslint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@lwn-simulator/contracts": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.102.0",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "peerDependencies": {
    "material-symbols": "^0.45.9",
    "react": "^19",
    "react-dom": "^19"
  }
}

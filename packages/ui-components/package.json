{
  "name": "@lwn-simulator/ui-components",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./scss/*": "./dist/scss/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:css": "sass src/styles/main.scss dist/styles.css --no-source-map",
    "build:scss": "shx mkdir -p dist/scss && shx cp src/styles/breakpoints.scss src/styles/fonts.scss dist/scss",
    "build:types": "shx mkdir -p dist/types && shx cp src/types/*.d.ts dist/types",
    "build": "yarn build:ts && yarn build:css && yarn build:scss && yarn build:types",
    "lint:ts": "eslint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "storybook": "npx storybook dev -p 6006",
    "build-storybook": "npx storybook build"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@lwn-simulator/contracts": "workspace:*",
    "@lwn-simulator/sdk": "workspace:*",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/nextjs-vite": "^10.5.4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-storybook": "^10.5.4",
    "material-symbols": "^0.45.9",
    "react-docgen-typescript": "^2.4.0",
    "react-toastify": "^11.1.0",
    "shx": "^0.4.0",
    "storybook": "^10.5.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tsc-alias": "^1.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "^8.1.5"
  },
  "peerDependencies": {
    "@lwn-simulator/contracts": "workspace:*",
    "@lwn-simulator/sdk": "workspace:*",
    "material-symbols": "^0.45.9",
    "react-toastify": "^11.1.0"
  }
}

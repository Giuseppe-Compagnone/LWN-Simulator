{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,

    "outDir": "./dist",
    "rootDir": "./src",

    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Bundler",

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,

    "sourceMap": true,

    "jsx": "react-jsx",

    "isolatedModules": true
  },
  "include": ["src", "types/**/*.d.ts"]
}

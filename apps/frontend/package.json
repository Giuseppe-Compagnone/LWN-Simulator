{
  "name": "@lwn-simulator/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "ELECTRON_BUILD=true next build && yarn copy",
    "copy": "../../scripts/copy-frontend.sh",
    "start": "next start",
    "lint:ts": "eslint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "gen-map": "tsx src/scripts/generate-map-themes.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lwn-simulator/contracts": "workspace:*",
    "@lwn-simulator/sdk": "workspace:*",
    "@lwn-simulator/ui-components": "workspace:*",
    "classnames": "^2.5.1",
    "maplibre-gl": "5.9.0",
    "material-symbols": "^0.45.10",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.2",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }

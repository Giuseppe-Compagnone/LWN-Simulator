{
  "name": "@lwn-simulator/desktop",
  "version": "1.0.0",
  "desktopName": "lwn-simulator",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc --build",
    "start": "yarn compile && electron .",
    "build": "rm -rf dist && yarn compile && electron-builder",
    "lint": "eslint"
  },
  "dependencies": {
    "@lwn-simulator/contracts": "workspace:*",
    "@lwn-simulator/sdk": "workspace:*",
    "@lwn-simulator/ui-components": "workspace:*",
    "electron-store": "^11.0.2",
    "material-symbols": "^0.47.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/electron": "^1.6.12",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "globals": "^17.9.0",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0"
  },
  "build": {
    "appId": "com.lwn.simulator",
    "productName": "LWN-Simulator",
    "executableName": "lwn-simulator",
    "icon": "public/icon.png",
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "."
      },
      {
        "from": "public",
        "to": "."
      },
      {
        "from": "../launcher/out",
        "to": "launcher/out"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true
    }
  }
}

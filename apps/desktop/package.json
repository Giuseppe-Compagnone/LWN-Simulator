{
  "name": "@lwn-simulator/desktop",
  "version": "1.0.0",
  "desktopName": "lwn-simulator",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc",
    "start": "yarn compile && electron .",
    "build": "rm -rf dist && yarn compile && electron-builder"
  },
  "dependencies": {
    "@lwn-simulator/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^26.1.2",
    "electron": "38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.lwn.simulator",
    "productName": "LWN-Simulator",
    "executableName": "lwn-simulator",
    "icon": "public/icon.png",
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "."
      },
      {
        "from": "public",
        "to": "."
      },
      {
        "from": "../launcher/out",
        "to": "launcher/out"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true
    }
  }
}

{
  "name": "desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lwn.simulator",
    "productName": "LWN Simulator",
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "."
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
